# Build context for the root Dockerfile (it needs public/data/rag-chunks.json, so
# the context has to be the repo root). Docker only reads a .dockerignore at the
# context root, so server/.dockerignore never applies — without this file the
# whole 440 MB node_modules and an 81 MB dist/ get uploaded as context.
node_modules
*/node_modules
server/lib
server/tests
server/coverage
dist
dev-dist
coverage
test-results
playwright-report
.git
.github
.claude
android
ios
apple
archive
e2e
/src
/tests
/scripts
docs
screenshots
supabase
worker
*.log

# public/ is 64 MB and only one file is needed; re-include it explicitly.
public/
!public/data/
!public/data/rag-chunks.json
