# Copy to .env (server) / .env.local (client) and fill in.
# Every VITE_* var is compiled into the client bundle — never put a secret there.
#
# There is no Firebase in this project. Auth, the datastore and the API are all
# first-party: a Cloud Run service (server/) backed by Cloud SQL Postgres.
# See docs/RUNBOOK-deploy.md for how to provision them on a fresh GCP project.

# =============================================================================
# Client (Vite) — .env.local
# =============================================================================

# Origin of the API. Unset → the app runs FULLY LOCAL-FIRST: no auth, no cloud
# sync, no billing, everything in localStorage. That is the default for CI, the
# preview build and any contributor without a backend.
# VITE_API_BASE_URL=https://api.flygaca.com

# Set to 1 instead of the above when the SPA and the API are served from the same
# origin (e.g. a load balancer routing /api to Cloud Run).
# VITE_API_SAME_ORIGIN=1

# Where the ~130 MB regulatory corpus is served from. Unset → same-origin /data.
# Point at a GCS bucket to keep each deploy small. See docs/DATA-HOSTING.md.
# VITE_DATA_BASE_URL=https://storage.googleapis.com/<bucket>/data

# GA4 measurement id. Unset → no analytics is loaded at all.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Moyasar publishable key — public by design (it can only start a card charge).
# The matching secret key lives ONLY in the server's Secret Manager entry.
# Use pk_test_… locally. See docs/BILLING.md.
VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_replace_me

# =============================================================================
# Server (Cloud Run) — .env, or Secret Manager in production
# =============================================================================

# --- required --------------------------------------------------------------

# Cloud SQL Postgres. On Cloud Run use the unix socket so no IP allowlist or
# proxy sidecar is needed:
#   postgresql://USER:PASS@/flygaca?host=/cloudsql/PROJECT:REGION:INSTANCE
# Locally:
#   postgresql://postgres:postgres@localhost:5432/flygaca
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flygaca

# HS256 signing key for session JWTs. Minimum 32 chars; rotate via Secret Manager.
#   openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Public origins. APP_ORIGIN is where the SPA is served (OAuth returns and email
# links point here); API_ORIGIN is this service's own public URL.
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8080

# --- auth ------------------------------------------------------------------

# Google OAuth client (GCP console → APIs & Services → Credentials → OAuth
# client ID → Web application). Authorized redirect URI must be exactly:
#   ${API_ORIGIN}/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Set only when the SPA and API share a registrable domain — it lets the session
# cookie use the stricter SameSite=Lax. Leave empty for cross-site (SameSite=None).
# SESSION_COOKIE_DOMAIN=.flygaca.com
# SESSION_TTL_DAYS=30

# Extra CORS origins beyond the built-in allowlist, comma-separated.
# EXTRA_ALLOWED_ORIGINS=https://staging.flygaca.com

# --- transactional email ---------------------------------------------------

# Verification and password-reset links. With no API key the mail is LOGGED
# instead of sent, so sign-up still works end to end in local dev.
MAIL_API_KEY=
MAIL_FROM=Fly GACA <no-reply@flygaca.com>
# MAIL_ENDPOINT=https://api.resend.com/emails

# --- Captain Adel ----------------------------------------------------------

# The model endpoint for the RAG flow, in OpenAI chat-completions shape.
#
# Fly GACA keeps user data in-Kingdom (Cloud Run + Cloud SQL in me-central2), and
# the model call is the one hop that can leave it — so point this at a Saudi-hosted
# endpoint. Intended target: HUMAIN's ALLaM service (SDAIA's Arabic foundation
# model, Groq inference in Dammam). A self-hosted ALLaM behind vLLM in the same
# region works identically; so would any other compatible endpoint.
#
# No default: leaving this unset means Captain Adel refuses to call anything,
# rather than sending regulatory questions somewhere unintended.
MODEL_BASE_URL=
# Bearer token for the above. Secret Manager in production. Omit for an
# unauthenticated endpoint on a private network.
MODEL_API_KEY=

# Model ids per request tier. These MUST match the provider's own catalog — a
# mismatch is a 404 at first use, which is loud rather than silent.
# MODEL_ID_FAST=allam-7b-instruct
# MODEL_ID_PRO=allam-34b-instruct

# Where the BM25 corpus is loaded from — an https URL is fetched, anything else
# is read from disk. The Dockerfile bakes a copy in and sets this.
# CORPUS_URL=/app/data/rag-chunks.json

# Retrieval tuning (see docs/DESIGN-genkit-rag-backend.md §10).
# RETRIEVE_K=6
# REFUSE_SCORE=1.5
# GROUNDED_SCORE=4

# Free-question allowances. Defaults mirror server/src/chat-quota-core.ts, which
# the client also mirrors — tests/client-server-mirrors.test.ts pins the pair.
# CHAT_FREE_DAILY_LIMIT=5
# ANON_DAILY_LIMIT=3

# --- billing ---------------------------------------------------------------

# Moyasar secret key (sk_live_… / sk_test_…) — Secret Manager in production.
MOYASAR_SECRET_KEY=
# Shared secret from Moyasar dashboard → Webhooks, used to verify callbacks.
MOYASAR_WEBHOOK_SECRET=

# Shared secret the Cloud Scheduler renewal job presents as X-Cron-Secret when
# it calls POST /api/billing/renew.
CRON_SECRET=

# Price table, in SAR major units, VAT-INCLUSIVE (ZATCA requires a consumer-facing
# published price to already contain the 15%). A missing or non-positive value makes
# that checkout kind fail loudly rather than charge SAR 0.
# `tests/pricing-server-parity.test.ts` pins these to the display constants in
# src/pages/pricing/Pricing.tsx, src/lib/prepCatalog.ts and src/lib/services/pricing.ts.
# NOTE: this file is a template. The deployed Cloud Run revision's env is what actually
# charges a card — update it in the same change (see docs/RUNBOOK-deploy.md).
PRICE_PRO_MONTHLY=79
PRICE_PRO_ANNUAL=649
PRICE_PASS=299
PRICE_CREDITS=39
PRICE_PREP_PACK=249
PRICE_PREP_PACK_ESSENTIAL=249
PRICE_PREP_PACK_STANDARD=399
PRICE_PREP_PACK_COMPLETE=499
PRICE_BUNDLE=1499
PRICE_COHORT=12000
