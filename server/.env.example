# Fly GACA API Server — Environment Variables Template
# Copy this to .env.local for local development, or set in Cloud Run / Secret Manager for production.
# All values are examples; replace with actual values.

# ==============================================================================
# REQUIRED (Server fails to start if missing or invalid)
# ==============================================================================

# PostgreSQL connection string. On Cloud Run, use Unix socket.
# Local: postgresql://postgres:password@localhost/flygaca
# Cloud Run: postgresql://postgres:password@/flygaca?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://postgres:password@localhost/flygaca

# HS256 signing secret for session JWT. Must be at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-32-char-session-secret-here-minimum-32-chars-long

# ==============================================================================
# DEPLOYMENT & INFRASTRUCTURE
# ==============================================================================

# Node environment (development | production)
NODE_ENV=development

# Port to listen on (Cloud Run default: 8080)
PORT=8080

# Public origin of the SPA (used for OAuth redirects and cookie domain)
APP_ORIGIN=http://localhost:5173

# Public origin of this API (used to build OAuth callback URLs)
API_ORIGIN=http://localhost:8080

# Cookie domain (set for shared registrable domain; empty for localhost)
SESSION_COOKIE_DOMAIN=

# Session lifetime in days
SESSION_TTL_DAYS=30

# Cookie name
SESSION_COOKIE_NAME=fg_session

# Max database pool connections (keep low for Cloud Run horizontal scaling)
DATABASE_POOL_MAX=5

# ==============================================================================
# AUTHENTICATION & OAUTH
# ==============================================================================

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID of type "Web Application"
# Authorized redirect URIs: http://localhost:8080/api/auth/google/callback (dev)
#                            https://api.flygaca.com/api/auth/google/callback (prod)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Apple OAuth (https://developer.apple.com/account/resources/certificates/list)
# Requires:
#   - App ID with "Sign in with Apple" capability
#   - Services ID (for the web domain)
#   - Private key (.p8 file)
# Learn more: https://developer.apple.com/documentation/sign_in_with_apple
APPLE_OAUTH_CLIENT_ID=com.flygaca.web
APPLE_OAUTH_CLIENT_SECRET=your-apple-private-key-content

# ==============================================================================
# EMAIL SERVICE
# ==============================================================================

# Transactional email API (Resend or Resend-compatible)
# Optional: if absent, emails are logged to stdout instead of sent
MAIL_API_KEY=your-resend-api-key

# Email service endpoint (Resend-compatible)
MAIL_ENDPOINT=https://api.resend.com/emails

# From address for outbound emails
MAIL_FROM=Fly GACA <no-reply@flygaca.com>

# ==============================================================================
# PAYMENTS
# ==============================================================================

# Moyasar (Saudi payment provider)
# Keys: https://dashboard.moyasar.com/admin/api-keys
MOYASAR_SECRET_KEY=your-moyasar-secret-key
MOYASAR_WEBHOOK_SECRET=your-moyasar-webhook-secret

# ==============================================================================
# CAPTAIN ADEL (AI FLIGHT INSTRUCTOR)
# ==============================================================================

# Model endpoint (OpenAI-compatible) and API key
# Google Gemini (global, not in-Kingdom):
#   MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   MODEL_API_KEY=<your-google-genai-api-key>
#
# ALLaM (via HUMAIN, for in-Kingdom inference):
#   MODEL_BASE_URL=<humain-allam-endpoint>
#   MODEL_API_KEY=<humain-api-key>
#
# Note: Gemini calls leave the region; ALLaM keeps inference in-Kingdom.
# Leave MODEL_BASE_URL empty to disable Captain Adel (service still runs, chat endpoint returns 503).

MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_API_KEY=your-google-genai-api-key

# Model IDs (must match the provider's catalog)
# Google Gemini: https://ai.google.dev/gemini-api/docs/models/gemini
MODEL_ID_FAST=gemini-2.5-flash
MODEL_ID_PRO=gemini-2.5-pro

# ==============================================================================
# JOBS & AUTOMATION
# ==============================================================================

# Secret for Cloud Scheduler → POST /api/billing/renew (subscription renewal job)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-32-char-cron-secret-here

# ==============================================================================
# CHAT QUOTAS
# ==============================================================================

# Free questions per day for signed-in free-tier users
CHAT_FREE_DAILY_LIMIT=5

# Questions per purchased credit pack (mirrors src/lib/services/billing.ts)
CHAT_CREDIT_PACK_SIZE=50

# Kill switch for the Captain Adel chat gateway
CHAT_ENABLED=true

# ==============================================================================
# CORS (Optional)
# ==============================================================================

# Extra CORS origins beyond the built-in allowlist (comma-separated)
# Built-in: http://localhost:* (dev), https://flygaca.com (prod), https://captadel.com
EXTRA_ALLOWED_ORIGINS=

# ==============================================================================
# LOCAL DEVELOPMENT ONLY
# ==============================================================================

# If you're running a local database (not Cloud SQL), uncomment:
# DATABASE_URL=postgresql://postgres:password@localhost/flygaca

# If you want to test locally without actual OAuth, you can skip:
# GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET
# APPLE_OAUTH_CLIENT_ID, APPLE_OAUTH_CLIENT_SECRET
# MOYASAR_SECRET_KEY, MOYASAR_WEBHOOK_SECRET
# MAIL_API_KEY
# MODEL_API_KEY
# (They will use fallbacks or be disabled)
