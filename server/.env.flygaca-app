# Firebase Functions runtime params for the flygaca-app project (non-secret).
# Loaded automatically by `firebase deploy --only functions` (see docs/BILLING.md).
# SAR list prices in major units — keep in sync with src/pages/pricing/Pricing.tsx
# and the pack constants in src/lib/prepCatalog.ts.
MOYASAR_PRICE_PRO_MONTHLY_SAR=59
# The FOUNDING launch price. While `FOUNDING_OFFER` is true in Pricing.tsx the page
# advertises 349 with the 449 list price struck through, and there is no promo path
# on the annual button — checkout prices straight from this param, so this must BE
# the advertised number or the buyer is charged more than they were quoted. When the
# launch window closes, flip `FOUNDING_OFFER` to false and raise this to 449 in the
# SAME change. tests/pricing-server-parity.test.ts fails the build if they disagree.
MOYASAR_PRICE_PRO_ANNUAL_SAR=349
MOYASAR_PRICE_STUDENT_MONTHLY_SAR=39
MOYASAR_PRICE_STUDENT_ANNUAL_SAR=299
MOYASAR_PRICE_PASS_SAR=149
MOYASAR_PRICE_CREDITS_SAR=19
MOYASAR_PRICE_PREP_PACK_SAR=49
MOYASAR_PRICE_PREP_PACK_CERT_SAR=79
MOYASAR_PRICE_PREP_PACK_SUBJECT_SAR=49
MOYASAR_PRICE_BUNDLE_SAR=199
MOYASAR_PRICE_COHORT_SAR=6000
APP_ORIGIN=https://flygaca.com
# App Check enforcement on the /api/chat gateway — pinned on here; matches the
# ENFORCE_APP_CHECK defineBoolean default in functions/src/gateway.ts.
ENFORCE_APP_CHECK=true
# Apple Pay on the Moyasar widget. Off until public/.well-known/apple-developer-
# merchantid-domain-association is served from flygaca.com AND the domain is
# registered + validated in the Moyasar dashboard. Flip to true and redeploy then;
# until it is true, one-time checkouts offer card/mada + STC Pay only.
MOYASAR_APPLE_PAY=false
