# Cloudflare Pages headers (copied verbatim into dist/ by Vite; also honored by
# Netlify). Cloudflare Pages + Netlify are *mirror* fronts, never the canonical
# flygaca.com — that is served from a Cloud Storage bucket behind an HTTPS load
# balancer, with /api/* routed to Cloud Run (see docs/RUNBOOK-deploy.md). The
# mirrors noindex so they can't be indexed as duplicates of the canonical site.
#
# CAUTION: this blanket noindex applies to every path in this file's front. It
# ships inside dist/, so any host that honors _headers and serves this build
# noindexes the whole site — never put the canonical origin behind one without
# removing the rule first.
/*
  X-Robots-Tag: noindex, follow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.moyasar.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://cdn.moyasar.com; img-src 'self' data: blob: https://*.googleusercontent.com https://cdn.moyasar.com https://www.googletagmanager.com https://storage.googleapis.com; font-src 'self'; connect-src 'self' https://api.moyasar.com https://www.google-analytics.com https://storage.googleapis.com; frame-src 'self' https://api.moyasar.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

/sw.js
  Cache-Control: no-cache

# Serve the crawl/AI-discovery files as text/xml, never as the SPA HTML fallback.
/robots.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
