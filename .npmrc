# typescript-eslint@8 declares a `typescript` peer range that stops short of the
# TS 7 this repo compiles with (see scripts/link-lint-typescript.mjs — the same
# gap that hack exists for). Strict peer resolution therefore ERESOLVEs on every
# plain `npm ci`; verified 2026-08 — the old comment blaming "Capacitor v6
# plugins on a v8 core" was stale (all @capacitor/* are 8.x). Drop this flag
# together with the link-lint hack once typescript-eslint supports TS 7
# (typescript-eslint#10940).
legacy-peer-deps=true
